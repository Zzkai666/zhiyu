import{test}from'node:test';import assert from'node:assert/strict';import{mergePaper}from'../src/mergePaper.ts';import type{Paper}from'../src/api.ts';
const p={id:'paper',revision:3,status:'阅读中',page:3,zoom:100,readAt:'2026-11-14T00:03:00Z',totalPages:38,remark:'new',remarkRevision:2}as Paper;
test('out-of-order metadata does not undo saved reading state or independent remarks',()=>{const merged=mergePaper(p,{...p,revision:2,status:'待阅读',page:1,readAt:'2026-11-14T00:01:00Z',remark:'old',remarkRevision:1,totalPages:0});assert.equal(merged.status,'阅读中');assert.equal(merged.page,3);assert.equal(merged.remark,'new');assert.equal(merged.totalPages,38)});
test('an independently saved remark remains usable after newer metadata and reading position',()=>{const merged=mergePaper(p,{...p,revision:2,page:1,readAt:'2026-11-14T00:01:00Z',remark:'saved in inspector',remarkRevision:3});assert.equal(merged.page,3);assert.equal(merged.revision,3);assert.equal(merged.remark,'saved in inspector')});
